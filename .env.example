# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it's already in .gitignore

# ── Production Supabase (supabase.com → Your Project → Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Sandbox Supabase (optional) ─────────────────────────────────────────────
# A second, isolated Supabase project for end-to-end registration and payment
# testing. Its edge functions hold Razorpay TEST keys, so a full checkout runs
# without moving money and without creating junk rows in production.
#
# Leave these unset and the sandbox is simply unavailable: the env switcher and
# the autofill button never render, and the app can only reach production.
# Setting them makes sandbox *selectable*, not active — the choice lives in
# sessionStorage and defaults to production.
VITE_SANDBOX_SUPABASE_URL=
VITE_SANDBOX_SUPABASE_ANON_KEY=

# Shared secret for the sandbox-purge edge function. Only meaningful on the
# sandbox project, which is disposable by design; the function stays inert
# unless SANDBOX_PURGE_ENABLED=true is also set as a secret on that project.
VITE_SANDBOX_PURGE_TOKEN=

# ── Admin panel credentials (change these before going live!)
VITE_ADMIN_EMAIL=admin@sehatsandhi.com
VITE_ADMIN_PASS=change_this_password

# WhatsApp Business number (with country code, no + or spaces)
# Update in src/types/index.ts → WA_NUMBER
