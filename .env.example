# Which Supabase project a build talks to.
#
# One pair of variables, one backend per deployment. There is no runtime
# switcher: staging is built against the sandbox project, production against the
# production one, and a browser cannot move a build between them.
#
#   Vercel → Settings → Environment Variables
#     Production scope  → the production project's URL and anon key
#     Preview scope     → the sandbox project's, plus VITE_IS_STAGING=true
#
# Locally the mode picks the file instead of the deployment picking the scope:
#
#   npm run dev        → .env.sandbox            (sandbox project)
#   npm run dev:prod   → .env.production.local   (production project)
#
# Both are gitignored. Copy the two blocks below into them, or copy this file to
# .env for a single default. Values: supabase.com → Your Project → Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Staging only ────────────────────────────────────────────────────────────
# Turns on the testing affordances: the signup autofill button, the admin
# sandbox purge panel, and the login code shown on screen rather than sent.
#
# NEVER set this to true on production. It is a build-time literal, so leaving
# it unset drops that code from the bundle entirely rather than merely hiding
# it — a production build does not ship the purge panel at all.
VITE_IS_STAGING=false

# Shared secret for the sandbox-purge edge function. Only meaningful on the
# sandbox project, which is disposable by design; the function stays inert
# unless SANDBOX_PURGE_ENABLED=true is also set as a secret on that project.
VITE_SANDBOX_PURGE_TOKEN=

# WhatsApp Business number (with country code, no + or spaces)
# Update in src/types/index.ts → WA_NUMBER
