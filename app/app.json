{
  "expo": {
    "name": "Sehatsandhi",
    "slug": "sehatsandhi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sehatsandhi.app",
      "permissions": [
        "NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0e9f6e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sehatsandhi uses your location to find doctors, pharmacies and ambulances near you, and to tell an ambulance where to come. / पास के डॉक्टर, फ़ार्मेसी और एम्बुलेंस ढूँढने के लिए।"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "To send a photo of your prescription or a report. / पर्ची या रिपोर्ट की फ़ोटो भेजने के लिए।",
          "cameraPermission": "To take a photo of a prescription or report. / पर्ची या रिपोर्ट की फ़ोटो लेने के लिए।"
        }
      ],
      "expo-document-picker"
    ],
    "scheme": "sehatsandhi",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "117c9d8b-828b-487d-9db9-758ffe12d8b5"
      }
    },
    "owner": "ng-technologies",
    "updates": {
      "url": "https://u.expo.dev/117c9d8b-828b-487d-9db9-758ffe12d8b5",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}