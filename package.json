{
  "name": "sehatsandhi-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode sandbox",
    "dev:prod": "vite --mode production",
    "build": "tsc && vite build && npm run build:prerender",
    "build:prerender": "vite build --ssr src/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",

    "migrate:status": "node scripts/migrate.mjs status --env sandbox",
    "migrate:sandbox": "node scripts/migrate.mjs up --env sandbox",
    "migrate:prod": "node scripts/migrate.mjs up --env prod",

    "sync:reference": "node scripts/sync-reference.mjs",
    "sync:reference:dry": "node scripts/sync-reference.mjs --dry-run",

    "admin:password": "node scripts/admin-password.mjs --env both",
    "admin:check": "node scripts/admin-password.mjs --env both --check",

    "schema:check": "node scripts/check-table-config.mjs && node scripts/gen-purge-manifest.mjs --check",
    "schema:gen": "node scripts/gen-purge-manifest.mjs",
    "schema:diff": "node scripts/schema-diff.mjs --env prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.2.2",
    "pg": "^8.22.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
