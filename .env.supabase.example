# Copy to .env.supabase and fill in. NEVER commit .env.supabase — it is gitignored.
#
# Direct Postgres connection strings, used only by the scripts in scripts/:
#   migrate.mjs           applies supabase/migrations/*.sql
#   sync-reference.mjs    copies reference data prod -> sandbox
#   schema-diff.mjs       reports drift between the repo and a database
#
# These carry the database password and bypass RLS entirely. They are NOT the
# anon keys in .env, and nothing in src/ ever reads them — they never reach the
# browser bundle.
#
# Where to find them: Supabase Dashboard → (your project) → Connect → the
# "Session pooler" URI. Port 5432, NOT the transaction pooler on 6543 —
# pg_dump needs session mode.
#
# Two things that will bite you:
#
#   1. The hostname must be the POOLER host. The old direct-connection form,
#      db.<ref>.supabase.co, no longer resolves for current projects, and the
#      username there is bare `postgres`. The pooler form embeds the project
#      ref in the username: postgres.<ref>
#
#   2. Percent-encode the password if it contains @ : / ? # [ ] or !
#      A literal @ makes the URL parse against the wrong host boundary and you
#      get a confusing "tenant or user not found" rather than an auth error.
#        @ -> %40    ! -> %21    # -> %23    / -> %2F    : -> %3A
#      e.g. password  Secret@2026!  becomes  Secret%402026%21

SUPABASE_DB_URL_PROD=postgresql://postgres.<prod-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL_SANDBOX=postgresql://postgres.<sandbox-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# sync-reference.mjs refuses to run if these two resolve to the same host and
# database, so a transposed value cannot overwrite production pricing.

# seed-sandbox-accounts.mjs — sandbox project only (Dashboard → Settings → API).
# The service role key bypasses RLS, so this must never be a production value;
# the script refuses to run if it resolves to the production project.
SANDBOX_SUPABASE_URL=https://<sandbox-ref>.supabase.co
SANDBOX_SERVICE_ROLE_KEY=<sandbox service role key>

# Supabase CLI personal access token (Dashboard → Account → Access Tokens).
# Wider than the database URLs above: it grants full account access — deploying
# functions, reading secrets, creating and deleting projects.
SUPABASE_ACCESS_TOKEN=<personal access token>

# Authorises the sandbox purge endpoint. Sandbox-only — never set for prod.
VITE_SANDBOX_PURGE_TOKEN=<random hex string>
