node_modules
dist
# Intermediate SSR bundle for scripts/prerender.mjs — a build artifact like dist.
dist-ssr
.env
.env.local
*.local
.DS_Store

# Every Supabase credential the scripts in scripts/ need: the migration/sync
# connection strings (which carry DB passwords), the sandbox service role key,
# and the CLI personal access token. That token is the widest of them — it grants
# full account access, including deploying functions, reading secrets, and
# creating and deleting projects.
.env.supabase
supabase/.temp/

# Editor swap/backup files — these mirror the buffer contents, so a swap file
# next to .env.supabase contains the credentials in plaintext even though the
# env file itself is ignored.
*.swp
*.swo
*.swn
*~
.*.sw?

# Per-mode local env files. These carry real anon keys for a specific project,
# so they are ignored exactly like .env — see .env.example for the shape.
.env.sandbox
.env.production.local
.env.*.local
